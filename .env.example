ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WANDB_API_KEY=
HF_TOKEN=

# Gemini CLI — used by data_gen.synth to generate synthetic trajectories.
# Auth is whatever your `gemini` CLI was configured with (Google login or
# a key here). GEMINI_MODEL pins a specific model; leave blank to let the
# CLI default. GEMINI_BIN overrides the binary path.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BIN=gemini
GEMINI_TIMEOUT=180

# Base model id. Single source of truth for both data formatting (its
# tokenizer + chat template) and training (its weights). Tested with
# Qwen2/Qwen2.5/Qwen3 Instruct, Llama-3.x Instruct, Mistral Instruct.
# Override per invocation with --model on build_dataset.sh or
# `model.name=...` overrides on `python -m train.train`.
MODEL=Qwen/Qwen2.5-7B-Instruct

# Squad gateway home. Contains config, squads.json, and per-squad gateway DBs
# at ~/.squad/{name}/squad.db. SQUAD_REPO is read from ~/.squad/config.
SQUAD_HOME=~/.squad

# Which registered squad to harvest from (matches the name in ~/.squad/squads.json).
SQUAD_NAME=default

# Where the runner writes per-agent session transcripts. This is *separate*
# from SQUAD_HOME — squad's session-transcript.ts hard-codes its own path
# and we treat it as a parameter so you can point at any directory or override
# per-invocation with --sessions-dir.
SQUAD_TRANSCRIPTS_DIR=~/.lobs/agents

# Optional override; if unset we look it up via load_squad_config() from
# SQUAD_HOME/config (which `squad onboard` populated).
# SQUAD_REPO=~/other/lobs/squad
