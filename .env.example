ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WANDB_API_KEY=
HF_TOKEN=

# Squad gateway home. Contains config, squads.json, and per-squad gateway DBs
# at ~/.squad/{name}/squad.db. SQUAD_REPO is read from ~/.squad/config.
SQUAD_HOME=~/.squad

# Which registered squad to harvest from (matches the name in ~/.squad/squads.json).
SQUAD_NAME=default

# Where the runner writes per-agent session transcripts. This is *separate*
# from SQUAD_HOME — squad's session-transcript.ts hard-codes its own path
# and we treat it as a parameter so you can point at any directory or override
# per-invocation with --sessions-dir.
SQUAD_TRANSCRIPTS_DIR=~/.lobs/agents

# Optional override; if unset we look it up via load_squad_config() from
# SQUAD_HOME/config (which `squad onboard` populated).
# SQUAD_REPO=~/other/lobs/squad
